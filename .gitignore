# Rust
/target
target/

# Node
node_modules/
dist/

# ONNX Runtime's binaries are copied in by scripts/copy-ort.mjs at build time
# from the npm package. 100 MB of vendor wasm does not belong in history, and
# a stale committed copy would silently outrank the one the build produces.
apps/web/public/ort/

# Deployment secrets, if any ever land here.
*.env
!*.env.example

.DS_Store
*.log

# What e2e/inspect.mjs writes beside whatever file it was pointed at.
*-transcript.txt
